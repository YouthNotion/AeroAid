# Supabase project → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key

# Optional: Supabase personal access token for managing auth settings from the CLI/API
# (supabase.com/dashboard/account/tokens). Never commit a real value.
SUPABASE_ACCESS_TOKEN=
